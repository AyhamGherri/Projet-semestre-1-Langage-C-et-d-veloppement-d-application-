<td class="navigation-only" colspan="2" style="border-top: 2px #F9F9F9 solid; font-size: 80%; background:inherit; color: inherit; text-align: right;"><span class="plainlinks" style="float:left;"><a rel="mw:ExtLink" href="https://fr.wikipedia.org/w/index.php?title=Grande_Muraille&amp;action=edit&amp;section=0" class="external text" data-mw-original-href="//fr.wikipedia.org/w/index.php?title=Grande_Muraille&amp;action=edit&amp;section=0"><span class="infodoc">modifier</span></a></span><span typeof="mw:Entity"> </span><span typeof="mw:File" data-mw='{"caption":"Consultez la documentation du modèle"}'><a href="https://fr.wikipedia.org/wiki/Modèle:Infobox_Patrimoine_mondial" title="Consultez la documentation du modèle"><img resource="https://fr.wikipedia.org/wiki/Fichier:Info_Simple.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/3/38/Info_Simple.svg/20px-Info_Simple.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/3/38/Info_Simple.svg/40px-Info_Simple.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="" data-file-width="512" data-file-height="512" data-file-type="drawing" height="12" width="12" class="mw-file-element"/></a></span></td>
