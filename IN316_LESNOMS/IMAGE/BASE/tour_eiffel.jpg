ge","href":"./Modèle:Page"},"params":{"1":{"wt":"17–18"}},"i":0}}]}'>p.</abbr><span typeof="mw:Entity" about="#mwt264" id="mwDPA"> </span><span class="nowrap" about="#mwt264" id="mwDPE">17–18</span>), Stephen Sauvestre (<abbr class="abbr" title="pages" about="#mwt265" typeof="mw:Transclusion" id="mwDPI" data-mw='{"parts":[{"template":{"target":{"wt":"Page","href":"./Modèle:Page"},"params":{"1":{"wt":"19–20"}},"i":0}}]}'>p.</abbr><span typeof="mw:Entity" about="#mwt265" id="mwDPM"> </span><span class="nowrap" about="#mwt265" id="mwDPQ">19–20</span>), Émile Nouguier (<abbr class="abbr" title="pages" about="#mwt266" typeof="mw:Transclusion" id="mwDPU" data-mw='{"parts":[{"template":{"target":{"wt":"Page","href":"./Modèle:Page"},"params":{"1":{"wt":"15–16"}},"i":0}}]}'>p.</abbr><span typeof="mw:Entity" about="#mwt266" id="mwDPY"> </span><span class="nowrap" about="#mwt266" id="mwDPc">15–16</span>) et Édouard Lockroy (<abbr class="abbr" title="pages" about="#mwt267" typeof="mw:Transclusion" id="mwDPg" data-mw='{"parts":[{"template":{"target":{"wt":"Page","href":"./Modèle:Page"},"params":{"1":{"wt":"67–70"}},"i":0}}]}'>p.</abbr><span typeof="mw:Entity" about="#mwt267" id="mwDPk"> </span><span class="nowrap" about="#mwt267" id="mwDPo">67–70</span>) et liste des plus hauts bâtiments en 1889 (<abbr class="abbr" title="page" about="#mwt268" typeof="mw:Transclusion" id="mwDPs" data-mw='{"parts":[{"template":{"target":{"wt":"Page","href":"./Modèle:Page"},"params":{"1":{"wt":"53"}},"i":0}}]}'>p.</abbr><span typeof="mw:Entity" about="#mwt268" id="mwDPw"> </span><span about="#mwt268" id="mwDP0">53</span>).</span></li>
