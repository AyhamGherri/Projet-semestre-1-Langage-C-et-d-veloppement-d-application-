<span style="white-space:nowrap"><span typeof="mw:File" data-mw='{"caption":"Réseau express régional d&apos;Île-de-France"}'><a href="https://fr.wikipedia.org/wiki/Réseau_express_régional_d'Île-de-France" title="Réseau express régional d'Île-de-France"><img resource="https://fr.wikipedia.org/wiki/Fichier:Paris_transit_icons_-_RER.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/6/69/Paris_transit_icons_-_RER.svg/20px-Paris_transit_icons_-_RER.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/6/69/Paris_transit_icons_-_RER.svg/40px-Paris_transit_icons_-_RER.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="(RER)" data-file-width="250" data-file-height="250" data-file-type="drawing" height="18" width="18" class="mw-file-element"/></a></span><span typeof="mw:Entity"> </span><span data-sort-value="C !"></span><span typeof="mw:File" data-mw='{"caption":"Ligne C du RER d&apos;Île-de-France"}'><a href="https://fr.wikipedia.org/wiki/Ligne_C_du_RER_d'Île-de-France" title="Ligne C du RER d'Île-de-France"><img resource="https://fr.wikipedia.org/wiki/Fichier:Paris_transit_icons_-_RER_C.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/Paris_transit_icons_-_RER_C.svg/20px-Paris_transit_icons_-_RER_C.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/Paris_transit_icons_-_RER_C.svg/40px-Paris_transit_icons_-_RER_C.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="(C)" data-file-width="250" data-file-height="250" data-file-type="drawing" height="18" width="18" class="mw-file-element"/></a></span></span> <a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/Gare_du_Champ_de_Mars_-_Tour_Eiffel" title="Gare du Champ de Mars - Tour Eiffel">Champ de Mars - Tour Eiffel</a></div></td></tr><tr class=""><th scope="row">Autobus</th><td class=""><div>
