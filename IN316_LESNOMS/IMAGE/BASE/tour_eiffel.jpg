</section><section data-mw-section-id="58" id="mwCq0" aria-labelledby="Répartition_des_émetteurs_de_télévision_selon_leur_canal_depuis_1935"><div class="mw-heading mw-heading5"><h5 id="Répartition_des_émetteurs_de_télévision_selon_leur_canal_depuis_1935"><span id="R.C3.A9partition_des_.C3.A9metteurs_de_t.C3.A9l.C3.A9vision_selon_leur_canal_depuis_1935" typeof="mw:FallbackId"></span>Répartition des émetteurs de télévision selon leur canal depuis 1935</h5></div>
<div style="column-count:3;column-gap:1em;" class="colonnes" about="#mwt636" typeof="mw:Transclusion" id="mwCq4" data-mw='{"parts":[{"template":{"target":{"wt":"Colonnes","href":"./Modèle:Colonnes"},"params":{"nombre":{"wt":"3"},"1":{"wt":"{{Légende|#CCCCCC|180 lignes}}\n{{Légende|#A6A6A6|455 lignes}}\n{{Légende|#858585|441 lignes}}\n{{Légende|#666666|819 lignes (norme E)}}\n{{Légende|#4D4D4D|625 lignes (norme L)}}\n{{Légende|blue|SECAM L et L&apos;}}\n{{Légende|red|[[DVB-T]] [[MPEG-2]]}}\n{{Légende|green|DVB-T [[MPEG-4]] [[H.264|AVC]]}}\n{{Légende|yellow|[[DVB-T2]] MPEG-H [[H.265|HEVC]]}}"}},"i":0}}]}'>
<li><span class="legende " style="margin-right:.3em;display:inline-block;width:1.3em;height:1.3em;webkit-print-color-adjust:exact;color-adjust:exact;background:#CCCCCC;border:1px solid gray;vertical-align:middle"></span>180 lignes</li>
<li><span class="legende " style="margin-right:.3em;display:inline-block;width:1.3em;height:1.3em;webkit-print-color-adjust:exact;color-adjust:exact;background:#A6A6A6;border:1px solid gray;vertical-align:middle"></span>455 lignes</li>
<li><span class="legende " style="margin-right:.3em;display:inline-block;width:1.3em;height:1.3em;webkit-print-color-adjust:exact;color-adjust:exact;background:#858585;border:1px solid gray;vertical-align:middle"></span>441 lignes</li>
<li><span class="legende " style="margin-right:.3em;display:inline-block;width:1.3em;height:1.3em;webkit-print-color-adjust:exact;color-adjust:exact;background:#666666;border:1px solid gray;vertical-align:middle"></span>819 lignes (norme E)</li>
<li><span class="legende " style="margin-right:.3em;display:inline-block;width:1.3em;height:1.3em;webkit-print-color-adjust:exact;color-adjust:exact;background:#4D4D4D;border:1px solid gray;vertical-align:middle"></span>625 lignes (norme L)</li>
<li><span class="legende " style="margin-right:.3em;display:inline-block;width:1.3em;height:1.3em;webkit-print-color-adjust:exact;color-adjust:exact;background:blue;border:1px solid gray;vertical-align:middle"></span>SECAM L et L'</li>
<li><span class="legende " style="margin-right:.3em;display:inline-block;width:1.3em;height:1.3em;webkit-print-color-adjust:exact;color-adjust:exact;background:red;border:1px solid gray;vertical-align:middle"></span><a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/DVB-T" title="DVB-T">DVB-T</a> <a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/MPEG-2" title="MPEG-2">MPEG-2</a></li>
<li><span class="legende " style="margin-right:.3em;display:inline-block;width:1.3em;height:1.3em;webkit-print-color-adjust:exact;color-adjust:exact;background:green;border:1px solid gray;vertical-align:middle"></span>DVB-T <a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/MPEG-4" title="MPEG-4">MPEG-4</a> <a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/H.264" title="H.264">AVC</a></li>
<li><span class="legende " style="margin-right:.3em;display:inline-block;width:1.3em;height:1.3em;webkit-print-color-adjust:exact;color-adjust:exact;background:yellow;border:1px solid gray;vertical-align:middle"></span><a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/DVB-T2" title="DVB-T2">DVB-T2</a> MPEG-H <a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/H.265" title="H.265">HEVC</a></li>
</div>
